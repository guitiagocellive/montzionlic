{
  "name": "montzionlic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && npm run deploy:ci",
    "deploy:ci": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "wrangler": "^4.157.0"
  }
}
