{
  "$schema": "node_modules/wrangler/config-schema.json",
  // O nome precisa ser igual ao do Worker criado no painel da Cloudflare.
  "name": "montzionlic",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Verificação de hora em hora para os avisos de sessões, entregas e atas.
  "triggers": { "crons": ["0 * * * *"] },
  "r2_buckets": [
    {
      "binding": "ARQUIVOS",
      // Criado sozinho no primeiro deploy (o R2 precisa estar ativado na conta).
      "bucket_name": "montzionlic-arquivos"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "montzionlic-db",
      // Sem ID: no primeiro deploy a Cloudflare cria o banco com este nome (ou usa o que já existir).
      "migrations_dir": "migrations"
    }
  ]
}
